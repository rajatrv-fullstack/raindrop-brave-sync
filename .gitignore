# ── Never commit anything below. These are per-install and/or private. ──

# Secrets
# Only the bare .env is ignored: .env.example (empty RAINDROP_TOKEN=, comments) is
# tracked so a fresh clone can be installed. A .env.* wildcard would swallow it, and a
# !.env.example negation makes "git check-ignore -v" report the file as matched.
.env
*.pem
*.key
key.pem*
.extension-identity.json

# Your library, your bookmarks, your activity
state.db
state.db.*
desired.json
applied.json
reset_folders.json
taxonomy.json
collection-map.json
vendor-allowlist.json
config.json
backups/
log/
*.log

# Browser artifacts
Bookmarks
Bookmarks.bak
*.crx

# Local resolved paths
.python-path
launchd/*.local.plist

# OS / editor
.DS_Store
__pycache__/
*.pyc
.venv/

# coverage data (CI produces its own)
.coverage
.coverage.*
coverage.txt
